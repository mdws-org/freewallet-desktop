+  vm.runInContext('processBtcpayQueue()', env);
+  assert.ok(!env.calls.some(c => c[0] === 'dialogBTCpay'), 'no manual prompt over a password dialog');
+  assert.ok(env.calls.some(c => c[0] === 'autoBtcpay'), 'auto-pay with a stash still proceeds');
